          match search with
          | store.Candidate.None => ok false
          | store.Candidate.Clone _ => ok true
        if b2
        then ok store.Resolved.Mismatch
        else
          let b3 ←
            match hint with
            | store.Candidate.None => ok false
            | store.Candidate.Clone _ => ok true
