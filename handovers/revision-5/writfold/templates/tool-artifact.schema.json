{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed admitted tool artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "platform",
    "url",
    "archive_sha256",
    "executable_sha256",
    "provenance",
    "license"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
