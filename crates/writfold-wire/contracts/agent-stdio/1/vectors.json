        {
          "id": "ready",
          "kind": "initialize",
          "generation": 1
        },
        {
          "id": "done",
          "kind": "shutdown",
          "generation": 2
        }
      ],
      "exit_code": 0
    },
    {
      "name": "unknown-extra-field-retains-safe-id",
      "frames": [
