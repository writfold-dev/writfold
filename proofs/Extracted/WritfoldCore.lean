def plan.round.exit
  (b : plan.round.Bounds) (rounds : Std.Usize) (met : Slice Bool) :
  Result plan.round.Exit
  := do
  if rounds >= b.min
  then
    let b1 ← plan.round.all_met met
    if b1
    then ok plan.round.Exit.Met
    else
      if rounds < b.max
      then ok plan.round.Exit.Again
      else ok plan.round.Exit.Spent
  else
    if rounds < b.max
    then ok plan.round.Exit.Again
    else ok plan.round.Exit.Spent

