    {
      "name": "shutdown-notification-closes",
      "frames": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"id\":\"start\",\"params\":{\"protocol_version\":\"2\"}}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"shutdown\"}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"unknown\",\"id\":\"unread\"}"
