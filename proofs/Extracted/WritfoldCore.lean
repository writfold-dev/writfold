    let i := Slice.len «prefix»
    if i = 3#usize
    then
      let e ← Slice.index_usize «prefix» 2#usize
      let b ← flow.is_claimed e
      if b
      then
        let e1 ← Slice.index_usize «prefix» 0#usize
        flow.prepared e1 candidate
      else ok false
    else ok false
  | flow.Event.Abandoned reason =>
    let i := Slice.len «prefix»
    if i = 3#usize
    then
