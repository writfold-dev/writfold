    if now > i
    then ok true
    else
      if seen > 0#i64
      then
        let i1 ← core.num.I64.MIN + seen
        if now < i1
        then ok false
        else let i2 ← now - seen
             ok (i2 > ttl)
      else let i1 ← now - seen
           ok (i1 > ttl)
  else
    if seen > 0#i64
    then
      let i ← core.num.I64.MIN + seen
      if now < i
      then ok false
      else let i1 ← now - seen
           ok (i1 > ttl)
    else let i ← now - seen
         ok (i > ttl)

