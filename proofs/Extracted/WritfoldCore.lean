  if last < 0#i64
  then
    let i ← core.num.I64.MAX + last
    if now > i
    then ok core.num.I64.MAX
    else
      if last > 0#i64
      then
        let i1 ← core.num.I64.MIN + last
        if now < i1
        then ok core.num.I64.MIN
        else now - last
      else now - last
  else
    if last > 0#i64
    then
      let i ← core.num.I64.MIN + last
      if now < i
      then ok core.num.I64.MIN
      else now - last
    else now - last

