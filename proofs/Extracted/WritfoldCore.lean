def verdict.recorded.before
  (a : verdict.recorded.Statement) (b : verdict.recorded.Statement) :
  Result Bool
  := do
  if a.age != b.age
  then ok (a.age < b.age)
  else
    if a.recorded != b.recorded
    then ok a.recorded
    else
      let i ← verdict.recorded.worst a.said
      let i1 ← verdict.recorded.worst b.said
